{
  "$comment": "Generated by desktop-codegen from tooling/codegen/src/localization. Do not edit. To regenerate, run: cargo run -p desktop-codegen --locked -- localization generate",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "entries": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "pattern": "^[A-Za-z0-9 ,.()-]{1,120}$",
            "type": "string"
          },
          "text": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            },
            "type": "object"
          }
        },
        "required": [
          "description",
          "text"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,4}$"
      },
      "type": "object"
    },
    "locales": {
      "items": {
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceLocale": {
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "sourceLocale",
    "locales",
    "entries"
  ],
  "title": "Localization catalog",
  "type": "object"
}
